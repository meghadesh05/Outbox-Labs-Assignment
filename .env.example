# ReachInbox Email Scheduler Environment Configuration

# Application Port
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Connection String
# e.g., postgresql://postgres:password@localhost:5432/reachinbox or Neon / Supabase URL
# If local PostgreSQL is not running, the application will automatically fall back to embedded in-memory PostgreSQL for seamless zero-setup testing!
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox

# Redis Connection URL (Used for BullMQ and Atomic Hourly Rate Limiting)
REDIS_URL=redis://127.0.0.1:6379

# Elasticsearch Connection URL (Used for Full-Text Email Indexing & Search)
# If Elasticsearch is unreachable, the system automatically falls back to database search.
ELASTICSEARCH_URL=http://127.0.0.1:9200

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth 2.0 Client ID
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Slack OAuth 2.0 Credentials
# Obtain from Slack API Console -> Your Apps -> OAuth & Permissions
# Redirect URL: http://localhost:5000/api/slack/callback
# Scopes needed: incoming-webhook, chat:write
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# Security Secrets (Generate random strings for production)
JWT_SECRET=super_secret_jwt_reachinbox_key_2026
COOKIE_SECRET=super_secret_cookie_reachinbox_key_2026

# Email Scheduling & Worker Tuning
# WORKER_CONCURRENCY: Number of jobs the BullMQ worker can process simultaneously
WORKER_CONCURRENCY=5

# MIN_DELAY_BETWEEN_EMAILS_MS: Minimum interval in milliseconds enforced between staggered emails
MIN_DELAY_BETWEEN_EMAILS_MS=2000
